# ============================================
# NACOS TAU Chapter — Backend Environment Template
# ============================================
# Copy this file to `.env` and fill in real values.
# DO NOT commit `.env` to version control (it is already listed in .gitignore).

# ============================================
# Server
# ============================================
PORT=5000
NODE_ENV=development
# (Railway / Cloudflare / Nginx). Set to "true" or specific proxy IPs for rate
# limiting to key on the real client IP instead of the proxy IP.
TRUST_PROXY=true

# ============================================
# Frontend (for CORS + password reset redirects)
# ============================================
# Local dev: http://localhost:5000 or http://localhost:3000
# Production: https://nacos-tau-chapter.netlify.app or your custom domain
FRONTEND_URL=http://localhost:5000

# ============================================
# Supabase
# ============================================
# Project URL (Dashboard → Project Settings → API → Project URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Service Role key (SECRET — NEVER expose to the frontend. Bypasses RLS).
# Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...<service-role-key>...

# Anon / Public key (safe to ship in frontend env.js).
# Dashboard → Project Settings → API → anon public
SUPABASE_ANON_KEY=eyJhbGciOi...<anon-public-key>...

# ============================================
# Admin Access Control
# ============================================
# Comma-, semicolon-, or JSON-array-separated list of emails allowed to reach
# the /api/auth/admin/login endpoint. First entry becomes the super_admin
# when `npm run seed` is executed.
#
# Examples:
#   ADMIN_EMAILS=nacos@tau.edu.ng
#   ADMIN_EMAILS=nacos@tau.edu.ng,exco@tau.edu.ng,it-admin@tau.edu.ng
#   ADMIN_EMAILS=["nacos@tau.edu.ng","it-admin@tau.edu.ng"]
ADMIN_EMAILS=nacos@tau.edu.ng

# Password used ONLY when bootstrapping the admin user via `npm run seed`.
# After first login, change the password through Supabase Auth or dashboard.
ADMIN_PASSWORD=NacosAdmin2024!

# ============================================
# Rate Limiting (overrides built-in defaults)
# ============================================
# Default 100 requests / 15 min per IP on /api/*
GLOBAL_RATE_LIMIT=100

# ============================================
# Redis (Required for production rate limiting)
# ============================================
# Without this, all rate limiters (login, registration, voting, etc.) use an
# in-memory store that resets on every cold start. On Vercel and other
# serverless platforms this means rate limits provide NO real protection —
# an attacker can bypass them simply by waiting for the next cold start.
#
# RECOMMENDED: Upstash Redis (free tier, works natively with Vercel)
#   1. Go to https://upstash.com and create a free Redis database
#   2. In the database dashboard, click "Connect" → copy the REST URL
#      (it looks like: rediss://default:PASSWORD@HOST:PORT)
#   3. Paste it here:
#
REDIS_URL=

# Upstash free tier limits: 10,000 commands/day, 256MB storage.
# That is more than enough for a university portal with ~100–500 active users.
#
# Alternative providers:
#   - Redis Cloud (redislabs.com) — also has a free tier
#   - Railway Redis plugin  — $5/month, same region as your backend
#
# After adding REDIS_URL, redeploy your backend. You should see:
#   ✅ Redis Rate Limiting Enabled
#   ✅ Rate limiting: all limiters upgraded to Redis-backed store
# in your deployment logs.
#
# If REDIS_URL is left empty the server still starts and rate limiters
# fall back to in-memory — fine for local development, not for production.
