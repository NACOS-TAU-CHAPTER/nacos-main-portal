# ============================================
# NACOS TAU Portal — Vercel Environment Variables Template
# ============================================
# Add these in Vercel Project Settings -> Environment Variables
# NEVER commit production secrets, keys, or credentials to public Git repos!

NODE_ENV=production
FRONTEND_URL=https://nacosportal.vercel.app

# Supabase (Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Bachs HQ Payment Gateway
BACHS_SECRET_KEY=your_bachs_secret_key
BACHS_WEBHOOK_SECRET=your_bachs_webhook_secret

# Paystack Payment Gateway
PAYSTACK_SECRET_KEY=your_paystack_secret_key

# Redis (Upstash) for Rate Limiting & Sessions
REDIS_URL=rediss://default:your_redis_password@your-redis-instance.upstash.io:6379

# Admin & Security
ADMIN_EMAIL=nacos@tau.edu.ng
ADMIN_EMAILS=nacos@tau.edu.ng
ADMIN_PASSWORD=your_secure_admin_seed_password_here
WEBHOOK_SECRET_TOKEN=your_random_64_char_webhook_secret_token
JWT_SECRET=your_jwt_secret_here

# Email Configuration (SMTP / Gmail OAuth2)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=nacos@tau.edu.ng
SMTP_PASS=your_smtp_app_password
EMAIL_FROM="NACOS TAU <nacos@tau.edu.ng>"

# Gmail API OAuth2 (Preferred over SMTP to bypass cloud host port 465/587 blocks)
OAUTH_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
OAUTH_CLIENT_SECRET=your_oauth_client_secret
OAUTH_REFRESH_TOKEN=your_oauth_refresh_token
